      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Uses Go channel concurrency to safely manage connections and groups without mutexes. In-memory caching replays location to late joiners. Server overwrites client values to prevent spoofing. Rates are limited and inputs validated."
    },
    {
      "id": "readme_chat_media_architecture",
      "label": "Real-Time Chat & Media Architecture",
      "file_type": "rationale",
      "source_file": "D:\\Python codes\\real-time-location-sharing-system\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Hybrid communication pipeline combining REST (multipart upload for images) and persistent WebSockets (text and events). Content headers are sniffed to restrict payloads to images. Randomized hex filenames prevent traversal. Optimistic client rendering tracks message state."
    },
